# EditorConfig para estandarizar formato y saltos de línea en todo el equipo
root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{js,jsx,ts,tsx}]
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab
